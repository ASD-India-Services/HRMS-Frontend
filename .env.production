# HRMS Frontend — PRODUCTION environment
# Loaded by Vite when building with --mode production (npm run build -- --mode production).

# Identity Center (central auth) — moved to the ASD org domain
VITE_IDENTITY_CENTER_URL=https://accounts.asdindiaservices.com

# OAuth2 Client ID registered for the HRMS frontend in Identity Center
VITE_AUTH_CLIENT_ID=hrms-frontend

# OAuth2 redirect URI — must EXACTLY match the redirect URI registered in IC
VITE_AUTH_REDIRECT_URI=https://app.digihrms.com/auth/callback

# HRMS Backend API
VITE_API_BASE_URL=https://apiv1.digihrms.com

# CRM frontend URL (used by the product switcher to jump to the CRM)
# TODO: confirm the production CRM URL.
VITE_CRM_FRONTEND_URL=https://app.leadspoint.in
